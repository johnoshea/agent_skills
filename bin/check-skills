#!/usr/bin/env bash
# Checks every skill under skills/ for both hosts: the frontmatter name matches
# the directory, a description is present, SKILL.md stays under 60 lines, and
# a skill that one host may not invoke on its own says so for the other host
# too: disable-model-invocation in SKILL.md for Claude Code, and
# allow_implicit_invocation in agents/openai.yaml for Codex.
set -euo pipefail
cd "$(dirname "$0")/.."

status=0
fail() { echo "$1" >&2; status=1; }

for dir in skills/*/; do
    name=$(basename "$dir")
    skill="${dir}SKILL.md"
    [ -f "$skill" ] || { fail "$dir has no SKILL.md"; continue; }
    [ "$(head -n 1 "$skill")" = "---" ] || { fail "$skill: no frontmatter on line 1"; continue; }

    frontmatter=$(sed -n '2,/^---$/p' "$skill")
    declared=$(printf '%s\n' "$frontmatter" | sed -n 's/^name: *//p')
    [ "$declared" = "$name" ] || fail "$skill: name is '$declared', directory is '$name'"
    printf '%s\n' "$frontmatter" | grep -q '^description: .' || fail "$skill: no description"

    lines=$(awk 'END { print NR }' "$skill")
    [ "$lines" -lt 60 ] || fail "$skill: $lines lines, limit 60"

    claude_explicit=false
    printf '%s\n' "$frontmatter" | grep -qE '^disable-model-invocation: *true *$' && claude_explicit=true
    codex_explicit=false
    grep -qsE '^ *allow_implicit_invocation: *false *$' "${dir}agents/openai.yaml" && codex_explicit=true
    if [ "$claude_explicit" != "$codex_explicit" ]; then
        fail "$skill: explicit-only for one host only. Claude Code: disable-model-invocation: true in SKILL.md is $claude_explicit. Codex: allow_implicit_invocation: false in agents/openai.yaml is $codex_explicit."
    fi
done

[ "$status" -eq 0 ] && echo "skills ok"
exit "$status"
